[Unit]
Description=Stream Box: YouTube anti-bot tokens for yt-dlp (bgutil-ytdlp-pot-provider, port 4416)

[Service]
WorkingDirectory=%h/.local/share/bgutil-pot-provider/server
# The venv's Node (install.sh: nodejs-wheel) if it exists, otherwise the system one (image: nodejs package)
ExecStart=/usr/bin/env PATH=%h/.local/share/media-venv/bin:/usr/local/bin:/usr/bin node build/main.js
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
