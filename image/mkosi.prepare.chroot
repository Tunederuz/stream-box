#!/usr/bin/env bash
# Stream Box : utilisateur media, code de la box et tout ce qu'il installe hors pacman (venvs Python, serveur de jetons
# YouTube). Lancé par mkosi dans l'image, avec le réseau, juste après les paquets (« final ») ; mêmes étapes que
# install.sh, faites une fois pour toutes à la construction.
set -euo pipefail
[ "$1" = final ] || exit 0

BOX_USER=media
BOX_HOME=/home/$BOX_USER
# Pas de deno ni de nodejs-wheel (300 Mo) : yt-dlp résout ses défis JavaScript avec le Node du système (player.sh,
# remote.py : --js-runtimes node quand deno est absent)
MEDIA_VENV_PACKAGES="yt-dlp[default] bgutil-ytdlp-pot-provider jellyfin-mpv-shim paho-mqtt segno"
POT_REPO=https://github.com/Brainicism/bgutil-ytdlp-pot-provider.git
as_box() { (cd "$BOX_HOME" && runuser -u "$BOX_USER" -- env HOME="$BOX_HOME" bash -c "$1"); }

id "$BOX_USER" > /dev/null 2>&1 || useradd -m -s /bin/bash -G video,audio,input "$BOX_USER"
usermod -p '*' "$BOX_USER"   # pas de mot de passe ; connexion SSH par clé possible (~media/.ssh/authorized_keys)

# Code de la box : une copie git du dépôt (les mises à jour de la box reprennent ensuite par git pull)
rm -rf "$BOX_HOME/stream-box"
git -c safe.directory='*' clone -q /work/src/stream-box "$BOX_HOME/stream-box"
git -C "$BOX_HOME/stream-box" remote set-url origin https://github.com/Tunederuz/stream-box.git
# Les droits d'exécution posés à l'installation ne sont pas des modifications (sinon git pull refuse de mettre à jour)
git -C "$BOX_HOME/stream-box" config core.fileMode false
# Modifications pas encore validées (git clone ne prend que le dernier commit) : copie de l'arbre de travail
tar -C /work/src/stream-box --exclude=.git --exclude=image --exclude=node_modules -cf - . | tar -C "$BOX_HOME/stream-box" -xf -
cp "$BOX_HOME/stream-box/streamers.example.txt" "$BOX_HOME/stream-box/streamers.txt"
chown -R "$BOX_USER:$BOX_USER" "$BOX_HOME"

as_box '
  set -e
  mkdir -p ~/.local/bin ~/.local/share ~/.local/state/stream-box
  python3 -m venv ~/.local/share/streamlink-venv
  ~/.local/share/streamlink-venv/bin/pip install -q -U pip streamlink
  python3 -m venv ~/.local/share/ui-venv
  ~/.local/share/ui-venv/bin/pip install -q -U pip PySide6-Essentials python-mpv
  python3 -m venv ~/.local/share/media-venv
  ~/.local/share/media-venv/bin/pip install -q -U pip '"$MEDIA_VENV_PACKAGES"'
  ln -sf ~/.local/share/streamlink-venv/bin/streamlink ~/.local/bin/streamlink
  for tool in yt-dlp jellyfin-mpv-shim; do ln -sf ~/.local/share/media-venv/bin/$tool ~/.local/bin/$tool; done
  rm -rf ~/.cache/pip
'
as_box '
  set -e
  export PATH="$HOME/.local/share/media-venv/bin:$PATH"
  want=$(pip show bgutil-ytdlp-pot-provider | awk "/^Version/{print \$2}")
  dir=~/.local/share/bgutil-pot-provider
  git clone -q --depth 1 --branch "$want" '"$POT_REPO"' "$dir"
  (cd "$dir/server" && npm ci --no-audit --no-fund --loglevel=error && npx tsc \
     && npm prune --omit=dev --no-audit --no-fund --loglevel=error)   # outils de compilation retirés une fois compilé
  (cd ~/stream-box/cast && npm ci --omit=dev --no-audit --no-fund --loglevel=error)   # récepteur YouTube Cast
  rm -rf ~/.npm
'
