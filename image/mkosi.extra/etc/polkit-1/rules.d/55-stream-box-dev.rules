// Stream Box : media active ou coupe le mode développeur (stream-box-dev@enable|disable.service, rien d'autre)
polkit.addRule(function (action, subject) {
    if (subject.user == "media" && action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("verb") == "start" && /^stream-box-dev@(enable|disable)\.service$/.test(action.lookup("unit"))) {
        return polkit.Result.YES;
    }
});
