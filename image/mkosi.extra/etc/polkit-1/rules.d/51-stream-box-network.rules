// Stream Box : media pilote NetworkManager (mode configuration Wi-Fi : point d'accès, connexion à un réseau), même
// hors de la session de la TV
polkit.addRule(function (action, subject) {
    if (subject.user == "media" && action.id.indexOf("org.freedesktop.NetworkManager.") == 0) {
        return polkit.Result.YES;
    }
});
