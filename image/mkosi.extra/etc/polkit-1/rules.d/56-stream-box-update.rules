// Stream Box: media (remote.py) starts the system update and its check (stream-box-system-update.service,
// stream-box-update-check.service, nothing else): the TV menu's question, Settings → Updates, the companion app
polkit.addRule(function (action, subject) {
    var unit = action.lookup("unit");
    if (subject.user == "media" && action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("verb") == "start" &&
        (unit == "stream-box-system-update.service" || unit == "stream-box-update-check.service")) {
        return polkit.Result.YES;
    }
});
