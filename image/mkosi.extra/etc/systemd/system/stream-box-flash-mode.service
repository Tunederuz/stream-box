# Owlink: fewer writes when the system runs from a USB drive (see /usr/local/lib/stream-box/flash-mode); does
# nothing on an internal disk. Before the session, so that media's caches are in memory from the start.
[Unit]
Description=Owlink: fewer writes on a USB drive
After=local-fs.target systemd-journald.service
Before=greetd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/stream-box/flash-mode

[Install]
WantedBy=multi-user.target
