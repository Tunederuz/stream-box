# Owlink: the boot counts as good only once the box's server answers (see /usr/local/lib/stream-box/boot-check):
# a new system from an A/B update is then kept by systemd-bless-boot, otherwise systemd-boot goes back to the previous.
[Unit]
Description=Owlink: the box answers
After=greetd.service
Before=boot-complete.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/stream-box/boot-check
TimeoutStartSec=5min

[Install]
RequiredBy=boot-complete.target
