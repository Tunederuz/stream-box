# Stream Box: code and system files of the latest release (see /usr/local/lib/stream-box/system-update). Started by
# update.sh (media, allowed by /etc/polkit-1/rules.d/56-stream-box-update.rules): "Update now" and the weekly update.
[Unit]
Description=Stream Box: system update
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/stream-box/system-update
TimeoutStartSec=15min
