# Owlink: what lives in /etc put back from the persistent state (machine-id, developer mode, SSH password and
# host keys: see /usr/local/lib/stream-box/persist), before sshd and the session
[Unit]
Description=Owlink: system state put back
After=stream-box-persist.service
Before=sshd.service greetd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/stream-box/persist restore

[Install]
WantedBy=multi-user.target
