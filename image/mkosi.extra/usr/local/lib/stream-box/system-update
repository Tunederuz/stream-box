#!/usr/bin/env bash
# Inlet: system update (stream-box-system-update.service, started by remote.py when the user accepts: the TV
# menu's question, Settings → Updates, the companion app). Follows the releases (tags v*) of the repository.
#   system-update check   every day (stream-box-update-check.timer, or "Check for updates"): the newest release, written
#                         as "available" (and "checked") in system-update.json; nothing downloaded: the TV menu offers it
#
# A/B box (installed with two system partitions, the running one labelled stream-box_<version>): the whole system of
# the latest release through systemd-sysupdate (/usr/lib/sysupdate.d: signed, into the slot not in use, its UKI with 3
# tries; stream-box-boot-check and systemd-boot fall back to the previous version if it doesn't work). A box running
# from a USB drive (one slot) gets nothing: install it on the PC.
#
# Applying (restarting onto the new system, or the session for the files): started by hand (remote.py leaves
# ~/.local/state/stream-box/update-manual), at once when nothing plays; otherwise (something playing, or a run that
# was not asked for) the boot stays pinned on the running version (bootctl set-default) and the TV menu asks at each
# start and wake-up ("restart to apply?", apply-update).
#   system-update state   at boot (stream-box-update-state.service): whether an update is still waiting
#
# Direct update (developer mode only, started by hand: "Direct update (source)", remote.py leaves
# ~/.local/state/stream-box/update-direct holding the branch to follow), on any box: the files and not the system: the
# code and the system files below, from a branch (main by default, or one chosen in the TV menu: dev, exp/…) instead of
# the latest release; version shown as <system>+<commit> (dev). The box's code is put on that branch's commit as is,
# forwards or backwards: choosing main again is the way back from an experimental branch. Otherwise developer mode
# updates as any box does.
#
# Box installed before A/B (one system partition):
#   - its own copy of the repository, owned by root (/var/lib/stream-box/src): what is installed as root never comes
#     from media's copy, which media can change;
#   - the latest release's system files (image/mkosi.extra) installed, those that a release dropped removed (list of
#     what was installed: /var/lib/stream-box/system-files), the box's units that have an [Install] section enabled;
#   - media's code fast-forwarded to the release, never backwards (a box ahead of it, on main, keeps its code);
#   - the session restarted when something changed and nothing plays (otherwise: at the next restart).
# Not the Arch packages nor the kernel. Result in /var/lib/stream-box/system-update.json, read by remote.py.
set -euo pipefail
REPO=https://github.com/Tunederuz/stream-box.git
STATE=/var/lib/stream-box
SRC=$STATE/src
FILES=$STATE/system-files
BOX=/home/media/stream-box
install -d -m 750 -o root -g media "$STATE"

step=start tag="" files=0 code=same restart=no new="" kind=files available=keep branch=""
report() {   # ok message: system-update.json (readable by media through the group of the directory); the daily check's
  # fields (available, checked) carried over, available replaced unless "keep"
  python3 - "$STATE/system-update.json" "$1" "$2" "$tag" "$files" "$code" "$restart" "$new" "$kind" "$available" \
    "$branch" << 'PY'
import json, os, sys, time
path, ok, message, tag, files, code, restart, new, kind, available, branch = sys.argv[1:]
try:
    old = json.load(open(path))
except (OSError, ValueError):
    old = {}
d = {"ok": ok == "1", "message": message, "version": tag, "files": int(files), "code": code, "restart": restart,
     "new": new, "kind": kind, "date": time.strftime("%Y-%m-%dT%H:%M:%S"),
     "available": old.get("available", "") if available == "keep" else available, "checked": old.get("checked", ""),
     "branch": branch}
with open(path + ".tmp", "w") as f:
    json.dump(d, f)
os.chmod(path + ".tmp", 0o644)
os.replace(path + ".tmp", path)
PY
}
trap 'report 0 "failed: $step"' ERR

direct_branch() {   # branch asked in the direct update's marker (written by media: checked strictly), main by default
  local b
  b=$(head -c 200 /home/media/.local/state/stream-box/update-direct 2> /dev/null | head -n 1 | tr -d '[:space:]' || true)
  if [[ "$b" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]{0,99}$ ]] && [[ "$b" != *..* ]]; then echo "$b"; else echo main; fi
}

manual() {   # mark: started by hand within the last 2 h (the marker is used up)
  local mark=/home/media/.local/state/stream-box/$1
  [ -f "$mark" ] || return 1
  local age=$(( $(date +%s) - $(stat -c %Y "$mark") ))
  rm -f "$mark"
  [ "$age" -lt 7200 ]
}

# Some fields only (state at boot, daily check: the last update's date and result stay): key=value…
setf() {
  python3 - "$STATE/system-update.json" "$kind" "$tag" "$@" << 'PY'
import json, os, sys
path, kind, tag, *pairs = sys.argv[1:]
try:
    d = json.load(open(path))
except (OSError, ValueError):
    d = {"ok": True, "message": "", "kind": kind, "version": tag}
d.update(p.split("=", 1) for p in pairs)
if d.get("new"):
    d["kind"] = "ab"   # a newer system waits (after a direct update, for instance): applied as an A/B one
with open(path + ".tmp", "w") as f:
    json.dump(d, f)
os.chmod(path + ".tmp", 0o644)
os.replace(path + ".tmp", path)
PY
}

nothing_plays() {   # the box's server says the home screen is shown
  [ "$(curl -s -m 5 http://127.0.0.1:8080/api/state | python3 -c 'import json, sys; print(json.load(sys.stdin).get("mode", ""))' 2> /dev/null)" = home ]
}

is_manual="" direct=""
if [ -z "${1:-}" ]; then   # (not the boot state nor the daily check: they leave the markers)
  # One system update at a time: this one or a local one (local-update takes the same lock), both write the slot not
  # in use
  exec 9> /run/stream-box-system-update.lock
  if ! flock -n 9; then report 0 "another system update is running"; exit 0; fi
  if manual update-manual; then is_manual=1; fi
  # Direct update: asked by hand, developer mode still on
  branch=$(direct_branch)
  if manual update-direct && [ -e "$STATE/dev-mode" ]; then direct=1 is_manual=1; else branch=""; fi
  # Which update runs (until its result replaces the file): the TV and the companion app show it on its own row
  if [ -n "$direct" ]; then setf run=direct; else setf run=release; fi
fi

# Layout: system partitions (GPT type root-x86-64) on the disk of /, label of the running one
root_dev=$(findmnt -no SOURCE / | sed 's/\[.*//')
root_label=$(blkid -p -o value -s PART_ENTRY_NAME "$root_dev" 2> /dev/null || true)
disk=$(lsblk -no PKNAME "$root_dev" | head -n 1)
slots=0
for part in /sys/block/"$disk"/"$disk"*; do
  [ -e "$part/partition" ] || continue
  t=$(blkid -p -o value -s PART_ENTRY_TYPE "/dev/${part##*/}" 2> /dev/null || true)
  if [ "${t,,}" = 4f68bce3-e8cd-4db1-96e7-fbcaf984b709 ]; then slots=$((slots + 1)); fi
done

if [ "${1:-}" = check ]; then   # daily check: the newest release, nothing downloaded
  trap - ERR   # a failed check (no network…) leaves the last result as it is
  found=""
  if [[ "$root_label" == stream-box_* ]]; then
    kind=ab tag=v$(. /usr/lib/os-release && echo "${IMAGE_VERSION:-}")
    if [ "$slots" -ge 2 ]; then
      # {"available": "<version>" | null}; exit code 1 when nothing is newer, so the JSON tells success apart
      out=$(/usr/lib/systemd/systemd-sysupdate --no-pager --json=short check-new 2> /dev/null || true)
      found=$(python3 -c 'import json, sys; print(json.loads(sys.argv[1])["available"] or "")' "$out" 2> /dev/null) ||
        { echo "check failed (no answer from the releases)"; exit 1; }
    fi
  else   # box from before A/B: the latest release tag, when newer than the files installed
    if [ -d "$SRC/.git" ]; then git -C "$SRC" fetch -q --tags --force origin || { echo "check failed"; exit 1; }
    else rm -rf "$SRC"; git clone -q "$REPO" "$SRC" || { echo "check failed"; exit 1; }; fi
    latest=$(git -C "$SRC" tag -l 'v*' --sort=-v:refname | head -n 1)
    have=$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1])).get("version", ""))' "$STATE/system-update.json" 2> /dev/null || true)
    have=${have%%+*}   # (direct update: <release>+<commit>)
    if [ -n "$latest" ] && [ "$latest" != "$have" ] &&
       [ "$(printf '%s\n%s\n' "${have#v}" "${latest#v}" | sort -V | tail -n 1)" = "${latest#v}" ]; then
      found=${latest#v}
    fi
  fi
  setf available="$found" checked="$(date +%Y-%m-%dT%H:%M:%S)"
  echo "check: ${found:-up to date}"
  exit 0
fi

if [ -z "$direct" ] && [[ "$root_label" == stream-box_* ]]; then
  kind=ab
  tag=v$(. /usr/lib/os-release && echo "${IMAGE_VERSION:-}")
  if [ "$slots" -lt 2 ]; then
    report 1 "on a USB drive: install the box on the PC to get system updates"
    exit 0
  fi
  if [ "${1:-}" != state ]; then
    step=download
    /usr/lib/systemd/systemd-sysupdate --no-pager update
  fi
  # Newer system ready: the newest UKI in the ESP above the running version and not given up (+0-…: 3 failed tries,
  # systemd-boot went back to this one; it is not offered again until a newer release)
  step=restart
  esp=$(bootctl --print-esp-path 2> /dev/null || echo /boot)
  running=${tag#v}
  new=$(for f in "$esp"/EFI/Linux/stream-box_*.efi; do
          b=${f##*/stream-box_}
          case $b in *+0-*) continue ;; esac
          v=${b%.efi}; v=${v%%+*}
          if [ "$v" != "$running" ] && [ "$(printf '%s\n%s\n' "$running" "$v" | sort -V | tail -n 1)" = "$v" ]; then
            echo "$v"
          fi
        done | sort -V | tail -n 1)   # (if, not &&: with pipefail a last false test would fail the whole substitution)
  if [ -n "$new" ]; then
    code=image available=""   # installed: no longer offered
    if [ -n "$is_manual" ] && nothing_plays; then
      restart=now
      report 1 ""
      bootctl set-default "" 2> /dev/null || true   # the newest version boots
      systemctl reboot
      exit 0
    fi
    # Waiting for the user: the boot stays on the running version until apply-update
    bootctl set-default "stream-box_$running.efi" > /dev/null 2>&1 || true
    restart=pending
  else
    bootctl set-default "" 2> /dev/null || true
  fi
  if [ "${1:-}" = state ]; then setf restart="$restart" new="$new"; else report 1 ""; fi
  exit 0
fi

if [ "${1:-}" = state ]; then   # files path: a boot applies the files, nothing waits
  [ -f "$STATE/system-update.json" ] && setf restart=no new=
  exit 0
fi

step=download
if [ -d "$SRC/.git" ]; then
  git -C "$SRC" fetch -q --tags --force origin
else
  rm -rf "$SRC"
  git clone -q "$REPO" "$SRC"
fi
if [ -n "$direct" ]; then   # the branch's last commit; version: the system's (or latest release) + that commit
  git -C "$SRC" fetch -q --force origin "refs/heads/$branch" || { report 0 "unknown branch: $branch"; exit 0; }
  ref=FETCH_HEAD
  base=$(. /usr/lib/os-release && echo "${IMAGE_VERSION:-}")
  base=${base:+v$base}
  base=${base:-$(git -C "$SRC" tag -l 'v*' --sort=-v:refname | head -n 1)}
  tag="$base+$(git -C "$SRC" rev-parse --short=7 FETCH_HEAD)"
  kind=direct
else
  tag=$(git -C "$SRC" tag -l 'v*' --sort=-v:refname | head -n 1)
  [ -n "$tag" ] || { report 0 "no release yet"; exit 0; }
  ref=refs/tags/$tag
fi
git -C "$SRC" checkout -q --force "$ref"
echo "files from $tag"

step="system files"
extra=$SRC/image/mkosi.extra
wanted=$(mktemp)
(cd "$extra" && find . -type f | sed 's|^\.||' | sort) > "$wanted"
while read -r f; do
  if [ ! -f "$f" ] || [ "$(sha256sum < "$extra$f")" != "$(sha256sum < "$f")" ]; then
    install -D -m "$(stat -c %a "$extra$f")" "$extra$f" "$f"
    files=$((files + 1))
    echo "installed $f"
  fi
done < "$wanted"
if [ -f "$FILES" ]; then   # dropped by this version
  while read -r f; do
    rm -f "$f"
    files=$((files + 1))
    echo "removed $f"
  done < <(comm -23 "$FILES" "$wanted")
fi
install -m 644 "$wanted" "$FILES"
rm -f "$wanted"
systemctl daemon-reload
for unit in /etc/systemd/system/stream-box-*.service /etc/systemd/system/stream-box-*.timer; do
  if [ -f "$unit" ] && grep -q '^\[Install\]' "$unit"; then systemctl enable -q "$(basename "$unit")"; fi
done

step=code
want=$(git -C "$SRC" rev-parse "$ref^{commit}")
if [ "$(runuser -u media -- git -C "$BOX" rev-parse HEAD)" != "$want" ]; then
  runuser -u media -- git -C "$BOX" fetch -q --tags --force origin   # tags moved upstream (page-v1) are taken as they are
  runuser -u media -- git -C "$BOX" fetch -q origin "refs/heads/${branch:-main}"
  if runuser -u media -- git -C "$BOX" merge-base --is-ancestor HEAD "$want"; then
    runuser -u media -- git -C "$BOX" merge -q --ff-only "$want"
    code=updated
  elif [ -n "$direct" ]; then   # another branch, or back from one: put on its commit as is (fails on local changes)
    runuser -u media -- git -C "$BOX" checkout -q --detach "$want"
    code=updated
  else
    code=ahead   # newer than the release (main, a branch), or local commits: kept
  fi
fi
echo "code: $code, system files changed: $files"

step=restart
[ -n "$direct" ] || available=""   # the latest release installed: no longer offered
if [ "$code" = updated ] || [ "$files" -gt 0 ]; then
  if [ -n "$is_manual" ] && nothing_plays; then
    restart=now
    report 1 ""
    rm -f /run/greetd.run
    systemctl restart greetd
    exit 0
  fi
  restart=pending
fi
report 1 ""
