#!/bin/sh
# Stream Box: Bluetooth radio off when the box shuts down (stream-box-bt-disconnect.service). A remote still connected
# when the power goes off makes the Bluetooth dongle wake the box right back up; a mere disconnection is not enough
# (the remote reconnects at once, the dongle answers and wakes the box): devices are disconnected, then the adapter is
# powered off. Nothing is remembered: bluetoothd powers the adapter on again at boot (AutoEnable, default true), and
# the remote reconnects at the next key press.
bluetoothctl devices Connected | while read -r _ mac _; do
  bluetoothctl disconnect "$mac" > /dev/null
done
bluetoothctl power off > /dev/null
exit 0
