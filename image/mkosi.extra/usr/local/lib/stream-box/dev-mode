#!/usr/bin/env bash
# Stream Box: developer mode, enabled or disabled from the TV System menu (stream-box-dev@enable|disable.service).
# The image has neither a root password nor sudo for media: without this mode, the installed box offers no root access.
#   enable  : passwordless sudo for media (/etc/sudoers.d/90-stream-box-dev), and SSH enabled (password shown on the
#             TV, see ssh-access): ssh media@box then sudo
#   disable : sudo removed (SSH keeps its own setting)
set -euo pipefail
SUDOERS=/etc/sudoers.d/90-stream-box-dev
MARK=/var/lib/stream-box/dev-mode   # readable by media (remote.py): /etc/sudoers.d is not
case "${1:-}" in
  enable)
    install -d -m 750 /etc/sudoers.d
    tmp=$(mktemp)
    echo 'media ALL=(ALL:ALL) NOPASSWD: ALL' > "$tmp"
    visudo -cqf "$tmp"
    install -m 440 "$tmp" "$SUDOERS"
    rm -f "$tmp"
    install -d -m 750 -o root -g media "$(dirname "$MARK")"
    touch "$MARK"
    "$(dirname "$0")/ssh-access" enable
    ;;
  disable)
    rm -f "$SUDOERS" "$MARK"
    ;;
  *) echo "usage: $0 enable|disable" >&2; exit 2 ;;
esac
