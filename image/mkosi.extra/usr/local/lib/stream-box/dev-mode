#!/usr/bin/env bash
# Stream Box : mode développeur, activé ou coupé depuis le menu Système de la TV (stream-box-dev@enable|disable.service).
# L'image n'a ni mot de passe root ni sudo pour media : sans ce mode, la box installée n'offre aucun accès root.
#   enable  : sudo sans mot de passe pour media (/etc/sudoers.d/90-stream-box-dev), et SSH activé (mot de passe affiché
#             sur la TV, voir ssh-access) : ssh media@box puis sudo
#   disable : sudo retiré (SSH garde son propre réglage)
set -euo pipefail
SUDOERS=/etc/sudoers.d/90-stream-box-dev
MARK=/var/lib/stream-box/dev-mode   # lisible par media (remote.py) : /etc/sudoers.d ne l'est pas
case "${1:-}" in
  enable)
    install -d -m 750 /etc/sudoers.d
    tmp=$(mktemp)
    echo 'media ALL=(ALL:ALL) NOPASSWD: ALL' > "$tmp"
    visudo -cqf "$tmp"
    install -m 440 "$tmp" "$SUDOERS"
    rm -f "$tmp"
    install -d -m 750 -o root -g media "$(dirname "$MARK")"
    touch "$MARK"
    "$(dirname "$0")/ssh-access" enable
    ;;
  disable)
    rm -f "$SUDOERS" "$MARK"
    ;;
  *) echo "usage : $0 enable|disable" >&2; exit 2 ;;
esac
