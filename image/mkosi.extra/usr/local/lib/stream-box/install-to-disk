#!/usr/bin/env bash
# Stream Box: installs the box running from a USB drive onto an internal disk, settings included.
#
#   install-to-disk <disk>      (nvme0n1, sda…; started by stream-box-install@<disk>.service, see installer.py)
#
# The disk is entirely erased: GPT table, 512 MB ESP (systemd-boot and kernel, copied from the USB drive's ESP), two
# 5 GB system partitions for A/B updates (A: the running system copied as is, compressed btrfs; B: empty until an
# update writes it, marked no-auto so that boot ignores it), and the data partition on the rest (label "data": the
# USB drive's /data, settings made on it; see persist). At boot, systemd finds the system partition by its type (no
# root= to write). State and progress: /run/stream-box-install.json, read by remote.py.
set -euo pipefail

DISK=${1:-}
STATUS=/run/stream-box-install.json
WORK=/run/stream-box-install
MIN_SIZE=$((16 * 1000 * 1000 * 1000))

status() {   # state, step, percentage, error
  local tmp
  tmp=$(mktemp "$STATUS.XXXX")
  python3 -c 'import json,sys; print(json.dumps({"state": sys.argv[1], "step": sys.argv[2], "percent": int(sys.argv[3]),
              "disk": sys.argv[4], "error": sys.argv[5] or None}))' "$1" "$2" "$3" "$DISK" "${4:-}" > "$tmp"
  chmod 644 "$tmp" && mv "$tmp" "$STATUS"
}
fail() { status error "${STEP:-}" 0 "$1"; exit 1; }
cleanup() {
  [ -n "${COPY_PID:-}" ] && kill "$COPY_PID" 2> /dev/null
  umount -R "$WORK/esp" "$WORK/root" "$WORK/data" 2> /dev/null || true
}
trap 'cleanup; [ "$(python3 -c "import json; print(json.load(open(\"$STATUS\"))[\"state\"])" 2> /dev/null)" = done ] || fail "${ERR:-error during: ${STEP:-Preparing}}"' EXIT

STEP="Checking the disk"
status running "$STEP" 0
[[ "$DISK" =~ ^[a-z0-9]+$ ]] && [ -b "/dev/$DISK" ] || { ERR="unknown disk"; exit 1; }
DEV=/dev/$DISK
root_disk=$(lsblk -no PKNAME "$(findmnt -no SOURCE / | sed 's/\[.*//')" | head -1)
[ "$DISK" != "$root_disk" ] || { ERR="this is the disk of the running box"; exit 1; }
read -r type rm tran size < <(lsblk -dnbo TYPE,RM,TRAN,SIZE "$DEV" | awk '{ if (NF == 3) print $1, $2, "-", $3; else print }')
[ "$type" = disk ] && [ "$rm" = 0 ] && [ "$tran" != usb ] || { ERR="this is not an internal disk"; exit 1; }
[ "$size" -ge "$MIN_SIZE" ] || { ERR="disk too small (16 GB at least)"; exit 1; }

STEP="Preparing the disk"
status running "$STEP" 2
for part in $(lsblk -lnpo NAME "$DEV" | tail -n +2); do
  swapoff "$part" 2> /dev/null || true
  umount -R "$part" 2> /dev/null || true
done
wipefs -aq "$DEV"
# System A takes the label of the running system partition (stream-box_<version>): its UKI, copied below, boots it by
# that label (root=PARTLABEL=…), and systemd-sysupdate reads the version from it
ROOT_LABEL=$(blkid -p -o value -s PART_ENTRY_NAME "$(findmnt -no SOURCE / | sed 's/\[.*//')" 2> /dev/null)
[[ "$ROOT_LABEL" =~ ^[A-Za-z0-9_.~+-]+$ ]] || ROOT_LABEL=root-x86-64
sfdisk -q --wipe always "$DEV" << PARTS
label: gpt
size=512MiB, type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B, name="esp"
size=5GiB, type=4F68BCE3-E8CD-4DB1-96E7-FBCAF984B709, name="$ROOT_LABEL"
size=5GiB, type=4F68BCE3-E8CD-4DB1-96E7-FBCAF984B709, name="_empty", attrs="GUID:63"
type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, name="data"
PARTS
udevadm settle
mapfile -t parts < <(lsblk -lnpo NAME "$DEV" | tail -n +2)
[ "${#parts[@]}" -eq 4 ] || { ERR="partitions not found after partitioning"; exit 1; }
mkfs.vfat -F 32 -n ESP "${parts[0]}" > /dev/null
mkfs.btrfs -q -f -L root "${parts[1]}"
mkfs.btrfs -q -f -L data "${parts[3]}"
mkdir -p "$WORK/root" "$WORK/esp" "$WORK/data"
mount -o compress=zstd "${parts[1]}" "$WORK/root"
mount "${parts[0]}" "$WORK/esp"
mount -o compress=zstd "${parts[3]}" "$WORK/data"

STEP="Copying the system"
status running "$STEP" 5
# The running system, without the other file systems (/proc, /sys, /run, /tmp, ESP…); progress based on the space
# used on the USB drive
used=$(df -B1 --output=used / | tail -1)
cp -a --one-file-system / "$WORK/root/" &
COPY_PID=$!
while kill -0 "$COPY_PID" 2> /dev/null; do
  pct=$((5 + 85 * $(df -B1 --output=used "$WORK/root" | tail -1) / (used > 0 ? used : 1)))
  status running "$STEP" $((pct > 90 ? 90 : pct))
  sleep 2
done
wait "$COPY_PID" || { COPY_PID=; ERR="system copy interrupted"; exit 1; }
COPY_PID=
# Mount points and subvolumes left out by --one-file-system
for d in proc sys dev run tmp efi boot data var/tmp var/log var/lib/machines var/lib/portables; do mkdir -p "$WORK/root/$d"; done
chmod 1777 "$WORK/root/tmp" "$WORK/root/var/tmp"

STEP="Copying the settings"
status running "$STEP" 90
# The USB drive's data partition (its settings, accounts, pairings…; the bound paths were left out of the copy above).
# Without one, the first boot of the disk takes them from the system partition (persist mount)
if mountpoint -q /data; then cp -a /data/. "$WORK/data/"; fi

STEP="Boot setup"
status running "$STEP" 92
esp=$(bootctl --print-esp-path 2> /dev/null || findmnt -nro TARGET -t vfat | head -1)
[ -n "$esp" ] && [ -d "$esp/EFI" ] || { ERR="USB drive ESP not found"; exit 1; }
cp -r "$esp"/. "$WORK/esp/"
# Boot entry for the disk in the firmware (otherwise it keeps its fallback path EFI/BOOT/BOOTX64.EFI)
bootctl install --esp-path="$WORK/esp" --graceful > /dev/null 2>&1 || true

STEP="Finishing"
status running "$STEP" 97
sync
umount -R "$WORK/esp" "$WORK/root" "$WORK/data"
status done "Installed" 100
