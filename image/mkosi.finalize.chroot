#!/usr/bin/env bash
# Stream Box: system services enabled and graphical boot. Here and not in mkosi.postinst.chroot: mkosi runs
# "systemctl preset-all" in between, which would put everything back to Arch's defaults.
set -euo pipefail
systemctl enable greetd.service NetworkManager.service bluetooth.service systemd-timesyncd.service \
  stream-box-bt-disconnect.service stream-box-flash-mode.service stream-box-persist.service stream-box-restore.service \
  stream-box-boot-check.service
# SSH off by default: it is enabled from the System menu ("SSH access", "Developer mode"), password shown
if [ -f /etc/ssh/stream-box-test-keys ]; then   # test image: SSH with the test key, for VM tests
  systemctl enable sshd.service
else
  systemctl disable sshd.service 2> /dev/null || true
fi
systemctl set-default graphical.target   # greetd (display-manager) is only started by graphical.target

# Slimming down, without affecting compatibility: headers, documentation, translations other than French and English,
# Qt development tools from the app's venv
rm -rf /usr/include /usr/share/doc /usr/share/man /usr/share/info /usr/share/gtk-doc
find /usr/share/locale -mindepth 1 -maxdepth 1 -type d ! -name 'fr*' ! -name 'en*' -exec rm -rf {} +
for d in /home/media/.local/share/ui-venv/lib/python3*/site-packages/PySide6; do
  rm -rf "$d"/{assistant,designer,linguist,lrelease,lupdate,qmlformat,qmllint,qmlls,qmlcachegen,qmltyperegistrar,uic,rcc} \
         "$d"/Qt/translations "$d"/include "$d"/typesystems "$d"/glue "$d"/scripts
done
