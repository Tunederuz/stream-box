#!/usr/bin/env bash
# Stream Box : services et réglages de l'image (après les paquets et mkosi.prepare.chroot)
set -euo pipefail
BOX_USER=media
BOX_HOME=/home/$BOX_USER
as_box() { (cd "$BOX_HOME" && runuser -u "$BOX_USER" -- env HOME="$BOX_HOME" bash -c "$1"); }

# SSH : clés seulement, coupé par défaut (mkosi.finalize.chroot, après le « preset-all » de mkosi qui l'annulerait)
install -d /etc/ssh/sshd_config.d
printf 'PasswordAuthentication no\nKbdInteractiveAuthentication no\n' > /etc/ssh/sshd_config.d/50-stream-box.conf
# (« Accès SSH » du menu Système : mot de passe affiché sur la TV, 10-stream-box-password.conf ; voir ssh-access)

# Services utilisateur de media : mises à jour, jetons YouTube, pont MQTT (sans config MQTT, celui-ci ne démarre pas)
as_box '
  set -e
  units=~/.config/systemd/user
  mkdir -p "$units/default.target.wants" "$units/timers.target.wants"
  cp ~/stream-box/systemd/*.service ~/stream-box/systemd/*.timer "$units/"
  ln -sf "$units/stream-box-pot.service" "$units/default.target.wants/"
  ln -sf "$units/stream-box-mqtt.service" "$units/default.target.wants/"
  ln -sf "$units/stream-box-update.timer" "$units/timers.target.wants/"
  install -d -m 700 ~/.config/stream-box ~/.config/jellyfin-mpv-shim
  echo qt > ~/.config/stream-box/player
'
# jellyfin-mpv-shim pilote le mpv de la box (même config que install.sh)
as_box 'cat > ~/.config/jellyfin-mpv-shim/conf.json' << 'JSON'
{
  "player_name": "Stream Box",
  "enable_gui": false,
  "headless": true,
  "fullscreen": true,
  "hwdec": "auto-safe",
  "mpv_ext": true,
  "mpv_ext_start": false,
  "mpv_ext_ipc": "/tmp/stream-box-mpv.sock",
  "mpv_ext_no_ovr": true,
  "mpv_idle_quit": false
}
JSON
chmod +x "$BOX_HOME"/stream-box/*.sh "$BOX_HOME"/stream-box/*.py

# Écran de démarrage : thème « spinner » de Plymouth avec le logo de la box et le fond de l'écran d'accueil ; il reste
# affiché jusqu'à la session (plymouth-quit.service.d/10-retain-splash.conf : quit --retain-splash)
theme=/usr/share/plymouth/themes/stream-box
mkdir -p "$theme"
cp /usr/share/plymouth/themes/spinner/*.png "$theme/"
# Logo : l'icône de la box en carré aux coins arrondis, et « Stream Box » dessous (comme le menu de la TV)
ffmpeg -loglevel error -y -f lavfi -i "color=c=black@0.0:s=640x330,format=rgba" -i /home/media/stream-box/icon-512.png \
  -filter_complex "[1:v]scale=200:200,format=rgba,geq=r=r(X\\,Y):g=g(X\\,Y):b=b(X\\,Y):a=if(gt(pow(max(abs(X-99.5)-58\\,0)\\,2)+pow(max(abs(Y-99.5)-58\\,0)\\,2)\\,42*42)\\,0\\,255)[ic];[0:v][ic]overlay=220:0,drawtext=fontfile=/usr/share/fonts/noto/NotoSans-Bold.ttf:text=Stream Box:fontcolor=white:fontsize=60:x=(w-text_w)/2:y=240" \
  -frames:v 1 "$theme/watermark.png"
cat > "$theme/stream-box.plymouth" << 'THEME'
[Plymouth Theme]
Name=Stream Box
Description=Logo de la box et roue de chargement, sur le fond de l'écran d'accueil
ModuleName=two-step

[two-step]
Font=Noto Sans 12
TitleFont=Noto Sans Light 30
ImageDir=/usr/share/plymouth/themes/stream-box
HorizontalAlignment=.5
VerticalAlignment=.72
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.42
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.382
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.382
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x0b0710
BackgroundEndColor=0x0b0710
ProgressBarBackgroundColor=0x606060
ProgressBarForegroundColor=0xffffff
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false
UseFirmwareBackground=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false
THEME
